@baseUrl = http://localhost:3000/api

### 1. GET all courses -- expect 200
GET {{baseUrl}}/courses

### 2. GET one course by id -- expect 200
GET {{baseUrl}}/courses/1

### 3. GET a course that does not exist -- expect 404
GET {{baseUrl}}/courses/9999

### 4. Search by title -- expect 200
GET {{baseUrl}}/courses/search/Data

### 5. POST -- create a new course
POST {{baseUrl}}/courses
Content-Type: application/json

{ "number": "CSC4600", "title": "Cloud Computing", "credits": 3,
  "description": "Test course", "prerequisites": [5, 9] }


### 6. PUT -- update/change a course --
PUT {{baseUrl}}/courses/7
Content-Type: application/json

{ "number": "CSC3700", "title": "Advanced Web Application Development", "credits": 3,
  "description": "React, Node/Express, MySQL, JWT authentication.", "prerequisites": [3, 5] }

### 7. DELETE -- remove YOUR created course-- replace /.. with the new id of the course created
DELETE {{baseUrl}}/courses/12

### 8. Confirm the delete -- expect 404
GET {{baseUrl}}/courses/12

### 9. POST missing required field -- expect 400
POST {{baseUrl}}/courses
Content-Type: application/json

{
  "title": "Incomplete Course"
}
